&nbsp;&nbsp;&nbsp;&nbsp;<span class="id" title="keyword">Proposition</span> <a id="limits_commute" class="idref" href="#limits_commute"><span class="id" title="lemma">limits_commute</span></a><br/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: <a class="idref" href="UniMath.CategoryTheory.Limits.Graphs.Limits.html#LimCone"><span class="id" title="definition">LimCone</span></a> (<a class="idref" href="UniMath.CategoryTheory.Limits.Graphs.Diagrams.html#product_diagram_swap"><span class="id" title="definition">product_diagram_swap</span></a> <span class="id" title="var">_</span> <span class="id" title="var">_</span> <a class="idref" href="UniMath.CategoryTheory.Limits.Graphs.Limits.html#LimitsOfProductGraphs.d"><span class="id" title="variable">d</span></a>).<br/>
