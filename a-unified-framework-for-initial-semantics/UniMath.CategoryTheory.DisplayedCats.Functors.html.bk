&nbsp;&nbsp;<span class="id" title="keyword">Coercion</span> <a class="idref" href="UniMath.CategoryTheory.DisplayedCats.Functors.html#disp_functor_on_objects"><span class="id" title="definition">disp_functor_on_objects</span></a> <a class="idref" href="UniMath.CategoryTheory.DisplayedCats.Functors.html#disp_functor_on_objects"><span class="id" title="definition">:</span></a> <a class="idref" href="UniMath.CategoryTheory.DisplayedCats.Functors.html#disp_functor_on_objects"><span class="id" title="definition">disp_functor_data</span></a> <a class="idref" href="UniMath.CategoryTheory.DisplayedCats.Functors.html#disp_functor_on_objects"><span class="id" title="definition">&gt;-&gt;</span></a> <a class="idref" href="UniMath.CategoryTheory.DisplayedCats.Functors.html#disp_functor_on_objects"><span class="id" title="definition">Funclass</span></a>.<br/>

